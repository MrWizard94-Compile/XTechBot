# XTechBot configuration. Copy this to .env.local (gitignored) and put REAL values there.
# Never put real secrets in this file — it is committed.

# --- Local Ollama (reply drafting + sandbox post simulation). No cloud API. ---
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"

# --- X (Twitter) API — OAuth 1.0a user context, from your X app's "Keys and tokens" page. ---
# Fill these ONLY in .env.local. With all four set you can enable Live mode (real search + reply);
# leave them blank to run in Sandbox mode (no calls to X at all).
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_TOKEN_SECRET=""

# Server port
PORT="3000"
